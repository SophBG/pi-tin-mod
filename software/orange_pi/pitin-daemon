#!/usr/bin/env python3
"""Pi Tin daemon for the Orange Pi Zero 2W (runs as root, pitin-daemon.service).

* Screen brightness: hold HOTKEY and press L2 / R2 (hold to keep changing), or use the web
  page. It sets the kernel backlight (/sys/class/backlight/pitin-backlight, hardware PWM on
  header pin 16), whose scale is already perceptual.
* RGB LEDs: effects off / static / breathing / rainbow / reactive (the LEDs next to a button
  light up when it is pressed). HOTKEY + Y turns them on and off, HOTKEY + A changes effect.
* Web page on port 8080 (http://<ip>:8080) to choose effect, colour and both brightnesses.
* Settings are kept in /var/lib/pitin/state.json.
The other hotkeys (save/load state, volume, menu, reset, exit) are RetroArch's.
"""
import colorsys
import glob
import json
import math
import os
import re
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import evdev
from evdev import ecodes as E

sys.path.insert(0, '/usr/local/lib/pitin')
import pitin_leds  # noqa: E402

STATE_FILE = '/var/lib/pitin/state.json'
BACKLIGHT_DIR = '/sys/class/backlight'
GAMEPAD = 'Pi Tin Gamepad'
EFFECTS = ['off', 'static', 'breathing', 'rainbow', 'reactive']
LED_MAX_SCALE = 0.4          # 100 % on the slider = 40 % of the LEDs' full power
FPS = 30

# Which LEDs sit next to which buttons (PCB references, see pitin_leds.py).
GROUPS = {
    E.BTN_START: ['D1'], E.BTN_SELECT: ['D2'],
    E.BTN_DPAD_UP: ['D3', 'D4', 'D5', 'D6'], E.BTN_DPAD_DOWN: ['D3', 'D4', 'D5', 'D6'],
    E.BTN_DPAD_LEFT: ['D3', 'D4', 'D5', 'D6'], E.BTN_DPAD_RIGHT: ['D3', 'D4', 'D5', 'D6'],
    E.BTN_SOUTH: ['D7', 'D8', 'D9', 'D10'], E.BTN_EAST: ['D7', 'D8', 'D9', 'D10'],
    E.BTN_NORTH: ['D7', 'D8', 'D9', 'D10'], E.BTN_WEST: ['D7', 'D8', 'D9', 'D10'],
    E.BTN_TL: pitin_leds.CHAIN, E.BTN_TR: pitin_leds.CHAIN,
    E.BTN_TL2: pitin_leds.CHAIN, E.BTN_TR2: pitin_leds.CHAIN,
}
HOTKEY = E.BTN_MODE

lock = threading.Lock()
state = {'effect': 'static', 'color': '#ff7a1a', 'leds_on': True, 'led_brightness': 50, 'screen': 100}
dirty = threading.Event()
flash = {}                   # LED ref -> intensity 0..1 for the reactive effect


def log(*a):
    print(*a, flush=True)


# ---------------------------------------------------------------- settings
def load_state():
    try:
        with open(STATE_FILE) as f:
            update(json.load(f), save=False)
    except (OSError, ValueError):
        pass


def update(changes, save=True):
    """Apply validated changes; returns the new state."""
    with lock:
        if changes.get('effect') in EFFECTS:
            state['effect'] = changes['effect']
        if isinstance(changes.get('color'), str) and re.fullmatch(r'#[0-9a-fA-F]{6}', changes['color']):
            state['color'] = changes['color'].lower()
        if isinstance(changes.get('leds_on'), bool):
            state['leds_on'] = changes['leds_on']
        for key, lo in (('led_brightness', 0), ('screen', 10)):
            if isinstance(changes.get(key), (int, float)):
                state[key] = int(max(lo, min(100, changes[key])))
        snapshot = dict(state)
    if save and 'screen' in changes:
        write_backlight(snapshot['screen'])
    if save:
        dirty.set()
    return snapshot


def saver():
    while True:
        dirty.wait()
        time.sleep(2)
        dirty.clear()
        with lock:
            data = json.dumps(state, indent=1)
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        tmp = STATE_FILE + '.tmp'
        with open(tmp, 'w') as f:
            f.write(data)
        os.replace(tmp, STATE_FILE)


_backlight_warned = False


def write_backlight(level):
    """level 10..100 % -> the backlight's brightness (pwm-backlight's default curve is perceptual)."""
    global _backlight_warned
    paths = sorted(glob.glob(BACKLIGHT_DIR + '/*'), key=lambda p: 'pitin' not in p)
    if not paths:
        if not _backlight_warned:
            log('no backlight in', BACKLIGHT_DIR, '(overlay or PWM driver missing?)')
            _backlight_warned = True
        return
    try:
        with open(paths[0] + '/max_brightness') as f:
            top = int(f.read())
        with open(paths[0] + '/brightness', 'w') as f:
            f.write(f'{max(1, round(level / 100 * top))}\n')
    except (OSError, ValueError) as e:
        log('backlight:', e)


# ---------------------------------------------------------------- LEDs
def hex_rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def render_loop():
    try:
        leds = pitin_leds.Leds()
    except (SystemExit, OSError) as e:      # no /dev/spidev*.1: run without LEDs
        log('LEDs disabled:', e)
        return
    pitin_leds.BRIGHTNESS = 1.0          # scaling is done here
    last, last_t = None, 0.0
    t0 = time.monotonic()
    while True:
        now = time.monotonic()
        t = now - t0
        with lock:
            s = dict(state)
        scale = s['led_brightness'] / 100 * LED_MAX_SCALE
        base = hex_rgb(s['color'])
        chain = pitin_leds.CHAIN
        if not s['leds_on'] or s['effect'] == 'off':
            frame = {}
        elif s['effect'] == 'static':
            frame = {ref: base for ref in chain}
        elif s['effect'] == 'breathing':
            k = 0.12 + 0.88 * (0.5 - 0.5 * math.cos(2 * math.pi * t / 3.0))
            frame = {ref: tuple(c * k for c in base) for ref in chain}
        elif s['effect'] == 'rainbow':
            frame = {}
            for i, ref in enumerate(chain):
                r, g, b = colorsys.hsv_to_rgb((t / 6.0 + i / len(chain)) % 1.0, 1, 1)
                frame[ref] = (r * 255, g * 255, b * 255)
        else:                                 # reactive
            with lock:
                for ref in list(flash):
                    flash[ref] *= 0.82
                    if flash[ref] < 0.02:
                        del flash[ref]
                frame = {ref: tuple(c * k for c in base) for ref, k in flash.items()}

        out = [tuple(int(c * scale) for c in frame.get(ref, (0, 0, 0))) for ref in chain]
        if out != last or now - last_t > 5:   # static frames are refreshed every 5 s
            leds.show(out)
            last, last_t = out, now
        time.sleep(max(0.0, 1 / FPS - (time.monotonic() - now)))


# ---------------------------------------------------------------- buttons
class Repeater:
    """Brightness steps while HOTKEY + L2/R2 are held: one step, then every 80 ms after 0.5 s."""

    def __init__(self):
        self.step = 0
        self.gen = 0
        self.cv = threading.Condition()
        threading.Thread(target=self.run, daemon=True).start()

    def start(self, step):
        with self.cv:
            self.step, self.gen = step, self.gen + 1
            self.cv.notify()

    def stop(self):
        with self.cv:
            self.step, self.gen = 0, self.gen + 1
            self.cv.notify()

    def run(self):
        while True:
            with self.cv:
                while not self.step:
                    self.cv.wait()
                step, gen = self.step, self.gen
            update({'screen': state['screen'] + step})
            delay = 0.5
            while True:
                with self.cv:
                    self.cv.wait(delay)
                    if self.gen != gen or not self.step:
                        break
                update({'screen': state['screen'] + step})
                delay = 0.08


def button_loop():
    repeater = Repeater()
    while True:
        dev = None
        while dev is None:
            for path in evdev.list_devices():
                d = evdev.InputDevice(path)
                if d.name == GAMEPAD:
                    dev = d
                    break
                d.close()
            if dev is None:
                time.sleep(2)
        log('buttons:', dev.path)
        held = set()
        try:
            for ev in dev.read_loop():
                if ev.type != E.EV_KEY:
                    continue
                if ev.value == 1:
                    held.add(ev.code)
                    with lock:
                        for ref in GROUPS.get(ev.code, []):
                            flash[ref] = 1.0
                    if HOTKEY in held and ev.code != HOTKEY:
                        if ev.code == E.BTN_TL2:
                            repeater.start(-5)
                        elif ev.code == E.BTN_TR2:
                            repeater.start(+5)
                        elif ev.code == E.BTN_WEST:            # Y
                            update({'leds_on': not state['leds_on']})
                        elif ev.code == E.BTN_EAST:            # A
                            nxt = EFFECTS[(EFFECTS.index(state['effect']) + 1) % len(EFFECTS)]
                            update({'effect': nxt, 'leds_on': True})
                elif ev.value == 0:
                    held.discard(ev.code)
                    if ev.code in (E.BTN_TL2, E.BTN_TR2, HOTKEY):
                        repeater.stop()
        except OSError:
            log('gamepad lost, searching again')
            time.sleep(1)


