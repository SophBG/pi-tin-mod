class Handler(BaseHTTPRequestHandler):
    def reply(self, code, body, ctype):
        data = body.encode()
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == '/':
            self.reply(200, PAGE, 'text/html; charset=utf-8')
        elif self.path == '/api/state':
            with lock:
                self.reply(200, json.dumps(state), 'application/json')
        else:
            self.reply(404, 'not found', 'text/plain')

    def do_POST(self):
        if self.path != '/api/state':
            return self.reply(404, 'not found', 'text/plain')
        try:
            n = min(int(self.headers.get('Content-Length', 0)), 4096)
            changes = json.loads(self.rfile.read(n) or b'{}')
            if not isinstance(changes, dict):
                raise ValueError
        except ValueError:
            return self.reply(400, 'bad request', 'text/plain')
        self.reply(200, json.dumps(update(changes)), 'application/json')

    def log_message(self, *a):
        pass


def web_port():
    try:
        for line in open('/etc/default/pitin'):
            k, _, v = line.strip().partition('=')
            if k == 'WEB_PORT':
                return int(v)
    except (OSError, ValueError):
        pass
    return 8080


def restore_backlight():
    """pwm-backlight is a module and may appear after this daemon starts."""
    for _ in range(60):
        if glob.glob(BACKLIGHT_DIR + '/*'):
            break
        time.sleep(0.5)
    with lock:
        level = state['screen']
    write_backlight(level)


def main():
    load_state()
    for target in (restore_backlight, saver, render_loop, button_loop):
        threading.Thread(target=target, daemon=True).start()
    port = web_port()
    if port:
        log('web page on port', port)
        ThreadingHTTPServer(('', port), Handler).serve_forever()
    else:
        threading.Event().wait()


if __name__ == '__main__':
    main()
