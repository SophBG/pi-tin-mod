sys.path.insert(0, '/usr/local/lib/pitin')
import pitin_leds  # noqa: E402

CONF = '/etc/default/pitin'
STATE_FILE = '/var/lib/pitin/state.json'
BACKLIGHT_DIR = '/sys/class/backlight'
WEB_PAGE = '/usr/local/lib/pitin/pitin-web.html'
GAMEPAD = 'Pi Tin Gamepad'
EFFECTS = ['off', 'static', 'wave', 'fade', 'reactive']
LEGACY = {'custom': 'static', 'breathing': 'fade', 'rainbow': 'wave'}   # older effect names
# Default wave order: left to right, following the buttons: D-pad (bottom-left, top-left,
# top-right, bottom-right), Select, Start, ABXY (bottom-left, top-left, top-right, bottom-right).
SEQ = ['D8', 'D9', 'D10', 'D7', 'D6', 'D5', 'D4', 'D1', 'D2', 'D3']
LED_MAX_SCALE = 0.4          # 100 % on the slider = 40 % of the LEDs' full power
FPS = 30
WAVE_RATE = 1.0              # LEDs per second at speed 5
FADE_PERIOD = 12.0           # seconds per trip round the colour wheel at speed 5
FAT32_MAX = 4 * 1024 ** 3 - 1

# The LEDs next to each button (PCB references, see pitin_leds.py): the D-pad and ABXY LEDs sit
# at the corners, so each direction or face button lights the two corners beside it.
DPAD, ABXY = ['D7', 'D8', 'D9', 'D10'], ['D1', 'D2', 'D3', 'D4']
GROUPS = {
    E.BTN_START: ['D5'], E.BTN_SELECT: ['D6'],
    E.BTN_DPAD_UP: ['D9', 'D10'], E.BTN_DPAD_DOWN: ['D8', 'D7'],
    E.BTN_DPAD_LEFT: ['D9', 'D8'], E.BTN_DPAD_RIGHT: ['D10', 'D7'],
    E.BTN_NORTH: ['D1', 'D2'], E.BTN_SOUTH: ['D4', 'D3'],             # X, B
    E.BTN_WEST: ['D1', 'D4'], E.BTN_EAST: ['D2', 'D3'],               # Y, A
    E.BTN_TL: DPAD, E.BTN_TL2: DPAD, E.BTN_TR: ABXY, E.BTN_TR2: ABXY,   # shoulders: their side
}
HOTKEY = E.BTN_MODE
HEX = re.compile(r'#[0-9a-fA-F]{6}')


def hsv(h):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, 1, 1)
    return (r * 255, g * 255, b * 255)


DEFAULT_COLORS = {ref: '#%02x%02x%02x' % tuple(round(c) for c in hsv(i / len(SEQ))) for i, ref in enumerate(SEQ)}

lock = threading.Lock()
state = {'effect': 'static', 'colors': dict(DEFAULT_COLORS), 'order': list(SEQ), 'wave': 'rainbow', 'leds_on': True,
         'led_brightness': 50, 'led_follow': True, 'speed': 5, 'screen': 100}
dirty = threading.Event()
flash = {}                   # LED ref -> intensity 0..1 for the reactive effect


def log(*a):
    print(*a, flush=True)


def config():
    c = {'ROM_MOUNT': '', 'WEB_PORT': '8080', 'WEB_PASSWORD': '', 'LANGUAGE': ''}
    try:
        with open(CONF) as f:
            for line in f:
                k, _, v = line.strip().partition('=')
                if k in c:
                    c[k] = v.strip().strip('"')
    except OSError:
        pass
    return c


CFG = config()


# ---------------------------------------------------------------- settings
def load_state():
    try:
        with open(STATE_FILE) as f:
            update(json.load(f), save=False)
    except (OSError, ValueError):
        pass


def led_level(s):
    """The LEDs' brightness now (0-100): their setting, or with led_follow that setting scaled by the screen's."""
    return round(s['led_brightness'] * s['screen'] / 100) if s['led_follow'] else s['led_brightness']


def snapshot():
    return dict(state, colors=dict(state['colors']), order=list(state['order']))


def update(changes, save=True):
    """Apply validated changes; returns the new state."""
    with lock:
        effect = changes.get('effect')
        if effect == 'static' and isinstance(changes.get('color'), str) and HEX.fullmatch(changes['color']):
            state['colors'] = {ref: changes['color'].lower() for ref in DEFAULT_COLORS}   # old one-colour setting
        effect = LEGACY.get(effect, effect)
        if effect in EFFECTS:
            state['effect'] = effect
        if changes.get('wave') in ('rainbow', 'mine'):
            state['wave'] = changes['wave']
        order = changes.get('order')
        if isinstance(order, list) and sorted(order, key=str) == sorted(DEFAULT_COLORS, key=str):
            state['order'] = list(order)
        if isinstance(changes.get('colors'), dict):
            for ref, value in changes['colors'].items():
                if ref in DEFAULT_COLORS and isinstance(value, str) and HEX.fullmatch(value):
                    state['colors'][ref] = value.lower()
        if isinstance(changes.get('leds_on'), bool):
            state['leds_on'] = changes['leds_on']
        if isinstance(changes.get('led_follow'), bool):
            state['led_follow'] = changes['led_follow']
        for key, lo, hi in (('led_brightness', 0, 100), ('screen', 10, 100), ('speed', 1, 10)):
            value = changes.get(key)
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                state[key] = int(max(lo, min(hi, value)))
        snap = snapshot()
    if save and 'screen' in changes:
        write_backlight(snap['screen'])
    if save:
        dirty.set()
    return snap


def saver():
    while True:
        dirty.wait()
        time.sleep(2)
        dirty.clear()
        with lock:
            data = json.dumps(state, indent=1)
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        tmp = STATE_FILE + '.tmp'
        with open(tmp, 'w') as f:
            f.write(data)
        os.replace(tmp, STATE_FILE)


_backlight_warned = False


def write_backlight(level):
    """level 10..100 % -> the backlight's brightness (pwm-backlight's default curve is perceptual)."""
    global _backlight_warned
    paths = sorted(glob.glob(BACKLIGHT_DIR + '/*'), key=lambda p: 'pitin' not in p)
    if not paths:
        if not _backlight_warned:
            log('no backlight in', BACKLIGHT_DIR, '(overlay or PWM driver missing?)')
            _backlight_warned = True
        return
    try:
        with open(paths[0] + '/max_brightness') as f:
            top = int(f.read())
        with open(paths[0] + '/brightness', 'w') as f:
            f.write(f'{max(1, round(level / 100 * top))}\n')
    except (OSError, ValueError) as e:
        log('backlight:', e)


def restore_backlight():
    """pwm-backlight is a module and may appear after this daemon starts."""
    for _ in range(60):
        if glob.glob(BACKLIGHT_DIR + '/*'):
            break
        time.sleep(0.5)
    with lock:
        level = state['screen']
    write_backlight(level)


# ---------------------------------------------------------------- LEDs
def hex_rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def lerp(a, b, f):
    return tuple(x + (y - x) * f for x, y in zip(a, b))


def frame_for(s, clock):
    """Colour (0..255 floats) of each LED for state s; clock runs faster or slower with s['speed']."""
    n = len(SEQ)
    effect = s['effect']
    if not s['leds_on'] or effect == 'off':
        return {}
    if effect == 'static':
        return {ref: hex_rgb(s['colors'][ref]) for ref in SEQ}
    if effect == 'wave':                        # each LED takes the colour the previous one had
        order = s['order']
        if s['wave'] == 'rainbow':
            return {ref: hsv((clock * WAVE_RATE - i) / n) for i, ref in enumerate(order)}
        pal = [hex_rgb(s['colors'][ref]) for ref in order]
        out = {}
        for i, ref in enumerate(order):
            p = (i - clock * WAVE_RATE) % n
            k = int(p) % n
            out[ref] = lerp(pal[k], pal[(k + 1) % n], p - int(p))
        return out
    if effect == 'fade':
        c = hsv(clock / FADE_PERIOD)
        return {ref: c for ref in SEQ}
    with lock:                                  # reactive: each LED flashes in its own colour
        for ref in list(flash):
            flash[ref] *= 0.82
            if flash[ref] < 0.02:
                del flash[ref]
        return {ref: tuple(c * k for c in hex_rgb(s['colors'][ref])) for ref, k in flash.items()}


def render_loop():
    try:
        leds = pitin_leds.Leds()
    except (SystemExit, OSError) as e:          # no /dev/spidev*.1: run without LEDs
        log('LEDs disabled:', e)
        return
    pitin_leds.BRIGHTNESS = 1.0                 # scaling is done here
    last, last_t, clock, prev = None, 0.0, 0.0, time.monotonic()
    while True:
        now = time.monotonic()
        with lock:
            s = snapshot()
        clock += min(0.2, now - prev) * 2 ** ((s['speed'] - 5) / 2.5)
        prev = now
        frame = frame_for(s, clock)
        scale = led_level(s) / 100 * LED_MAX_SCALE
        out = [tuple(int(c * scale) for c in frame.get(ref, (0, 0, 0))) for ref in pitin_leds.CHAIN]
        if out != last or now - last_t > 5:     # unchanged frames are refreshed every 5 s
            leds.show(out)
            last, last_t = out, now
        time.sleep(max(0.0, 1 / FPS - (time.monotonic() - now)))


# ---------------------------------------------------------------- buttons
class Repeater:
    """Repeats a step while its button is held (SPECIAL + L2/R2 or UP/DOWN): once, then every 80 ms after 0.5 s."""

    def __init__(self):
        self.action = None
        self.gen = 0
        self.cv = threading.Condition()
        threading.Thread(target=self.run, daemon=True).start()

    def start(self, action):
        action()                                        # the first step right away, even for a short tap
        with self.cv:
            self.action, self.gen = action, self.gen + 1
            self.cv.notify()

    def stop(self):
        with self.cv:
            self.action, self.gen = None, self.gen + 1
            self.cv.notify()

    def run(self):
        while True:
            with self.cv:
                while not self.action:
                    self.cv.wait()
                action, gen = self.action, self.gen
            due = time.monotonic() + 0.5
            while True:
                with self.cv:
                    while self.gen == gen and time.monotonic() < due:
                        self.cv.wait(due - time.monotonic())
                    if self.gen != gen:
                        break
                action()
                due = time.monotonic() + 0.08


# ---------------------------------------------------------------- on-screen messages and the hotkey list
RA_PORT = 55355              # RetroArch's network commands (network_cmd_enable in retroarch-pitin.cfg)
WORDS = {   # capitals only: RetroArch's on-screen font may not have accents
    'en': {'effect': 'LED EFFECT', 'screen': 'SCREEN BRIGHTNESS', 'volume': 'VOLUME',
           'leds_on': 'LEDS ON', 'leds_off': 'LEDS OFF',
           'hold_quit': 'HOLD START TO QUIT THE GAME', 'hold_reset': 'HOLD B TO RESTART THE GAME',
           'hold_load': 'HOLD L1 TO LOAD THE SAVED STATE',
           'effects': {'off': 'OFF', 'static': 'STATIC', 'wave': 'WAVE', 'fade': 'FADE', 'reactive': 'REACTIVE'}},
    'fr': {'effect': 'EFFET LED', 'screen': 'LUMINOSITE ECRAN', 'volume': 'VOLUME',
           'leds_on': 'LEDS ALLUMEES', 'leds_off': 'LEDS ETEINTES',
           'hold_quit': 'MAINTENIR START POUR QUITTER LE JEU', 'hold_reset': 'MAINTENIR B POUR RECOMMENCER LE JEU',
           'hold_load': 'MAINTENIR L1 POUR CHARGER LA SAUVEGARDE',
           'effects': {'off': 'ETEINT', 'static': 'FIXE', 'wave': 'VAGUE', 'fade': 'FONDU', 'reactive': 'REACTIF'}},
}


def retroarch(cmd, reply=False):
    """Send one network command to RetroArch; returns its reply ('' if none or not running)."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.settimeout(0.3)
            sock.sendto(cmd.encode(), ('127.0.0.1', RA_PORT))
            return sock.recv(4096).decode(errors='replace').strip() if reply else ''
    except OSError:
        return ''


def console_language():
    """LANGUAGE in /etc/default/pitin (en or fr), otherwise the system's language."""
    lang = CFG['LANGUAGE'].lower()
    if lang in WORDS:
        return lang
    lang = os.environ.get('LANG', '')
    try:
        with open('/etc/default/locale') as f:
            for line in f:
                if line.startswith('LANG='):
                    lang = line.split('=', 1)[1].strip().strip('"')
    except OSError:
        pass
    return 'fr' if lang.lower().startswith('fr') else 'en'


class Osd:
    """Text on the screen, as RetroArch's own messages (its SHOW_MSG network command; nothing happens if RetroArch
    isn't running). A value that keeps changing (a button held) is shown once it settles, so that messages
    don't pile up."""
    SETTLE = 0.25

    def __init__(self):
        self.words = WORDS[console_language()]
        self.text, self.changed = None, 0.0
        self.cv = threading.Condition()
        threading.Thread(target=self._sender, daemon=True).start()

    def say(self, text):
        with self.cv:
            self.text = unicodedata.normalize('NFKD', text).encode('ascii', 'ignore').decode()
            self.changed = time.monotonic()
            self.cv.notify()

    def _sender(self):
        while True:
            with self.cv:
                while self.text is None:
                    self.cv.wait()
                while time.monotonic() < self.changed + self.SETTLE:
                    self.cv.wait(self.changed + self.SETTLE - time.monotonic())
                text, self.text = self.text, None
            retroarch('SHOW_MSG ' + text)


def message(item, w):
    """On-screen text for a setting and its value."""
    s = snapshot()
    if item == 'effect':
        return f"{w['effect']}: {w['effects'][s['effect'] if s['leds_on'] else 'off']}"
    if item == 'onoff':
        return w['leds_on'] if s['leds_on'] and s['effect'] != 'off' else w['leds_off']
    if item == 'screen':
        return f"{w['screen']}: {s['screen']}%"
    v = get_volume()
    return f"{w['volume']}: {v}%" if v is not None else f"{w['volume']}: --"


def change(item, step):
    """One step of a setting; True if the value changed."""
    s = snapshot()
    effect = s['effect'] if s['leds_on'] else 'off'
    if item == 'effect':                        # 'off' is SPECIAL + Y's: it keeps the effect for later
        cycle = EFFECTS[1:]
        nxt = cycle[(cycle.index(s['effect']) + step) % len(cycle)] if s['effect'] in cycle else cycle[0]
        update({'effect': nxt, 'leds_on': True})
    elif item == 'onoff':
        if effect != 'off':
            update({'leds_on': False})
        else:                                   # on again, with the same effect (an 'off' effect becomes static)
            update({'leds_on': True, 'effect': 'static' if s['effect'] == 'off' else s['effect']})
    elif item == 'screen':
        return update({'screen': s['screen'] + 5 * step})['screen'] != s['screen']
    else:
        v = get_volume()
        if v is None or not set_volume(v + 5 * step):
            return False
        return get_volume() != v
    return True


class HotkeyList:
    """SPECIAL + SELECT: pauses the game and shows the list of hotkeys, a card drawn by RetroArch's overlay (switched
    with OVERLAY_NEXT: overlay 0 is empty, overlay 1 the card). The gamepad is grabbed meanwhile so that RetroArch
    doesn't see the presses (Buttons does the hotkeys without SPECIAL); SELECT closes it."""

    def __init__(self):
        self.is_open = False
        self.paused = False

    def open(self, dev):
        self.is_open = True
        try:
            dev.grab()
        except OSError as e:
            log('hotkey list: cannot grab the gamepad:', e)
        self.paused = retroarch('GET_STATUS', reply=True).startswith('GET_STATUS PLAYING')
        if self.paused:
            retroarch('PAUSE_TOGGLE')
        retroarch('OVERLAY_NEXT')                       # the card

    def close(self, dev):
        self.is_open = False
        try:
            dev.ungrab()
        except OSError:
            pass
        retroarch('OVERLAY_NEXT')                       # back to the empty overlay
        if self.paused and retroarch('GET_STATUS', reply=True).startswith('GET_STATUS PAUSED'):
            retroarch('PAUSE_TOGGLE')
        self.paused = False


class Buttons:
    """The hotkeys pitin-daemon handles (RetroArch has the others), and the hotkey list: while it is open, every
    button does its hotkey without SPECIAL; RetroArch's own ones are sent to it, since it doesn't see the grabbed
    gamepad."""
    HELD_KEYS = {E.BTN_TL2: ('screen', -1), E.BTN_TR2: ('screen', 1),            # hold to keep changing
                 E.BTN_DPAD_DOWN: ('volume', -1), E.BTN_DPAD_UP: ('volume', 1)}
    # Hotkeys that lose progress act only once the button has been held for HOLD seconds:
    # button: (RetroArch command, hint, whether the hotkey list closes first)
    HOLD_KEYS = {E.BTN_START: ('CLOSE_CONTENT', 'hold_quit', True), E.BTN_SOUTH: ('RESET', 'hold_reset', True),
                 E.BTN_TL: ('LOAD_STATE', 'hold_load', False)}
    RA_KEYS = {E.BTN_TR: 'SAVE_STATE', E.BTN_DPAD_LEFT: 'STATE_SLOT_MINUS', E.BTN_DPAD_RIGHT: 'STATE_SLOT_PLUS'}
    HOLD = 1.0

    def __init__(self, dev, repeater, card, osd):
        self.dev, self.repeater, self.card, self.osd = dev, repeater, card, osd
        self.held = set()
        self.presses = {}
        self.opening = self.closing = False
        self.then = None                                    # a RetroArch command to send once the list closes

    def stepper(self, item, step):
        first = True

        def action():
            nonlocal first
            if change(item, step) or first:             # held at the end of the range: said once
                self.osd.say(message(item, self.osd.words))
            first = False
        return action

    def long_press(self, code, press):
        if code not in self.held or self.presses.get(code) != press:
            return
        cmd, _, closes = self.HOLD_KEYS[code]
        if closes and self.card.is_open:
            self.closing = False
            self.card.close(self.dev)
        retroarch(cmd)

    def hotkey(self, code, in_list):
        """SPECIAL + code, or code alone while the hotkey list is open."""
        w = self.osd.words
        if code in self.HELD_KEYS:
            self.repeater.start(self.stepper(*self.HELD_KEYS[code]))
        elif code in self.HOLD_KEYS:
            self.osd.say(w[self.HOLD_KEYS[code][1]])
            threading.Timer(self.HOLD, self.long_press, (code, self.presses[code])).start()
        elif code == E.BTN_WEST:                            # Y: on / off, keeping the effect
            change('onoff', 0)
            self.osd.say(message('onoff', w))
        elif code == E.BTN_EAST:                            # A: next effect
            change('effect', 1)
            self.osd.say(message('effect', w))
        elif code == E.BTN_SELECT:                          # opens or closes the list once everything is released
            if in_list:
                self.closing = True
            else:
                self.opening = True
        elif in_list and code in self.RA_KEYS:              # save, save slot
            retroarch(self.RA_KEYS[code])
        elif in_list and code == E.BTN_NORTH:               # X: RetroArch's menu, after the list
            self.then, self.closing = 'MENU_TOGGLE', True

    def key(self, code, value):
        if value == 1:
            self.held.add(code)
            self.presses[code] = self.presses.get(code, 0) + 1
            with lock:
                for ref in GROUPS.get(code, []):
                    flash[ref] = 1.0
            if self.card.is_open:
                if code != HOTKEY:
                    self.hotkey(code, True)
            elif HOTKEY in self.held and code != HOTKEY:
                self.hotkey(code, False)
        elif value == 0:
            self.held.discard(code)
            if code in self.HELD_KEYS or code == HOTKEY:
                self.repeater.stop()
            if not self.held:                               # grab and release only with no button down,
                if self.opening:                            # so RetroArch never misses a release
                    self.opening = False
                    self.card.open(self.dev)
                elif self.closing:
                    self.closing = False
                    if self.card.is_open:
                        self.card.close(self.dev)
                    if self.then:
                        retroarch(self.then)
                        self.then = None

    def lost(self):
        self.repeater.stop()
        self.held.clear()
        if self.card.is_open:
            self.card.is_open = False
            retroarch('OVERLAY_NEXT')
            if self.card.paused:
                retroarch('PAUSE_TOGGLE')
                self.card.paused = False


def button_loop():
    repeater, osd, card = Repeater(), Osd(), HotkeyList()
    while True:
        dev = None
        while dev is None:
            for path in evdev.list_devices():
                d = evdev.InputDevice(path)
                if d.name == GAMEPAD:
                    dev = d
                    break
                d.close()
            if dev is None:
                time.sleep(2)
        log('buttons:', dev.path)
        buttons = Buttons(dev, repeater, card, osd)
        try:
            for ev in dev.read_loop():
                if ev.type == E.EV_KEY:
                    buttons.key(ev.code, ev.value)
        except OSError:
            buttons.lost()
            log('gamepad lost, searching again')
            time.sleep(1)


# ---------------------------------------------------------------- system
def run(*cmd):
    try:
        return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 1, str(e))


def get_volume():
    """The "Master" softvol of /etc/asound.conf; it exists once something has played sound."""
    m = re.search(r'\[(\d+)%\]', run('amixer', '-M', 'sget', 'Master').stdout)
    return int(m.group(1)) if m else None


def set_volume(v):
    return run('amixer', '-M', '-q', 'sset', 'Master', f'{int(max(0, min(100, v)))}%').returncode == 0


def local_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('192.0.2.1', 9))              # picks the outgoing interface; nothing is sent
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


def drive():
    root = os.path.realpath(CFG['ROM_MOUNT']) if CFG['ROM_MOUNT'] else ''
    if not root or not os.path.ismount(root):
        return {'mounted': False}
    st = os.statvfs(root)
    return {'mounted': True, 'free': st.f_bavail * st.f_frsize, 'total': st.f_blocks * st.f_frsize}


def info():
    d = {'hostname': socket.gethostname(), 'ip': local_ip(), 'port': int(CFG['WEB_PORT'] or 8080),
         'volume': get_volume(), 'drive': drive(),
         'retroarch': run('systemctl', 'is-active', 'pitin-retroarch.service').stdout.strip()}
    try:
        with open('/sys/class/thermal/thermal_zone0/temp') as f:
            d['temp_c'] = round(int(f.read()) / 1000, 1)
    except (OSError, ValueError):
        pass
    try:
        with open('/proc/uptime') as f:
            d['uptime_s'] = int(float(f.read().split()[0]))
    except (OSError, ValueError):
        pass
    return d


POWER = {'retroarch': ['systemctl', 'restart', 'pitin-retroarch.service'],
         'reboot': ['systemctl', 'reboot'], 'poweroff': ['systemctl', 'poweroff']}


# ---------------------------------------------------------------- ROM drive
class Refused(Exception):
    """An error for the web page: HTTP status, a short code the page translates, and an English message."""
    def __init__(self, status, key, message, **extra):
        super().__init__(message)
        self.status, self.key, self.message, self.extra = status, key, message, extra


FAT_BAD = re.compile(r'[<>:"\\|?*\x00-\x1f]')


def rom_path(rel):
    """(root, absolute path, clean relative path) inside the ROM drive, or Refused."""
    root = os.path.realpath(CFG['ROM_MOUNT']) if CFG['ROM_MOUNT'] else ''
    if not root or not os.path.ismount(root):
        raise Refused(409, 'not_mounted', 'The ROM drive is not mounted. Is the console plugged into a computer?')
    parts = [p for p in rel.split('/') if p]
    for p in parts:
        if p in ('.', '..') or FAT_BAD.search(p) or p.endswith((' ', '.')):
            raise Refused(400, 'bad_name', f'"{p}" is not a valid name on the ROM drive.')
    path = os.path.realpath(os.path.join(root, *parts))
    if path != root and not path.startswith(root + os.sep):
        raise Refused(400, 'bad_name', 'That path is outside the ROM drive.')
    return root, path, '/'.join(parts)


def tree(max_depth=4, max_entries=5000):
    """The whole ROM drive as nested folders (dot files are hidden: .Trashes, ._ files, uploads in progress)."""
    root = rom_path('')[0]
    count = 0

    def walk(path, rel, depth):
        nonlocal count
        node = {'name': os.path.basename(path) if rel else 'roms', 'path': rel, 'folders': [], 'files': []}
        try:
            entries = sorted(os.scandir(path), key=lambda e: e.name.lower())
        except OSError:
            return node
        for e in entries:
            if e.name.startswith('.') or count >= max_entries:
                continue
            count += 1
            sub = rel + '/' + e.name if rel else e.name
            if e.is_dir(follow_symlinks=False):
                node['folders'].append(walk(e.path, sub, depth + 1) if depth < max_depth else
                                       {'name': e.name, 'path': sub, 'folders': [], 'files': []})
            elif e.is_file(follow_symlinks=False):
                node['files'].append({'name': e.name, 'size': e.stat().st_size})
        return node

    return dict(drive(), tree=walk(root, '', 0), truncated=count >= max_entries)


# ---------------------------------------------------------------- web server
def page():
    try:
        with open(WEB_PAGE) as f:
            return f.read()
    except OSError:
        return '<p>Missing ' + WEB_PAGE + ': run install.sh again.</p>'


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, body, ctype='application/json'):
        data = (body if isinstance(body, str) else json.dumps(body)).encode()
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        if code == 401:
            self.send_header('WWW-Authenticate', 'Basic realm="Pi Tin"')
        self.end_headers()
        self.wfile.write(data)

    def authorized(self):
        password = CFG['WEB_PASSWORD']
        if not password:
            return True
        h = self.headers.get('Authorization', '')
        if not h.startswith('Basic '):
            return False
        try:
            given = base64.b64decode(h[6:]).decode().partition(':')[2]
        except ValueError:
            return False
        return hmac.compare_digest(given.encode(), password.encode())

    def body_json(self, limit=16384):
        n = int(self.headers.get('Content-Length') or 0)
        if n > limit:
            raise Refused(413, 'bad_request', 'Request too large.')
        try:
            data = json.loads(self.rfile.read(n) or b'{}')
        except ValueError:
            raise Refused(400, 'bad_request', 'Bad request.')
        if not isinstance(data, dict):
            raise Refused(400, 'bad_request', 'Bad request.')
        return data

    def route(self, method):
        if not self.authorized():
            return self.reply(401, {'code': 'password', 'error': 'Password needed.'})
        url = urllib.parse.urlsplit(self.path)
        path, query = urllib.parse.unquote(url.path), urllib.parse.parse_qs(url.query)
        try:
            handler = getattr(self, method.lower() + '_' + (path.strip('/').split('/') + [''])[1], None)
            if path == '/' and method == 'GET':
                return self.reply(200, page(), 'text/html; charset=utf-8')
            if not path.startswith('/api/') or not handler:
                raise Refused(404, 'not_found', 'Not found.')
            sub = path[len('/api/'):].partition('/')[2]
            code, body = handler(sub, query)
            self.reply(code, body)
        except Refused as e:
            self.reply(e.status, dict(e.extra, code=e.key, error=e.message))
        except OSError as e:
            self.reply(500, {'code': 'failed', 'error': f'{e.strerror or e}.'})

    def do_GET(self):
        self.route('GET')

    def do_POST(self):
        self.route('POST')

    def do_PUT(self):
        self.route('PUT')

    def do_DELETE(self):
        self.route('DELETE')

    # GET /api/state, POST /api/state {changes}
    def get_state(self, sub, q):
        with lock:
            return 200, snapshot()

    def post_state(self, sub, q):
        return 200, update(self.body_json())

    # GET /api/info, POST /api/volume {volume}, POST /api/power {action}
    def get_info(self, sub, q):
        return 200, info()

    def post_volume(self, sub, q):
        v = self.body_json().get('volume')
        if not isinstance(v, (int, float)) or isinstance(v, bool):
            raise Refused(400, 'bad_request', 'Give a volume from 0 to 100.')
        if not set_volume(v):
            raise Refused(409, 'no_volume', 'No volume control yet: it appears once a game or the menu has played sound.')
        return 200, {'volume': get_volume()}

    def post_power(self, sub, q):
        action = self.body_json().get('action')
        if action not in POWER:
            raise Refused(400, 'bad_request', 'Unknown action.')
        threading.Timer(0.5, run, POWER[action]).start()
        return 200, {'ok': True}

    # GET /api/tree, PUT /api/roms/<file>, DELETE /api/roms/<file or empty folder>,
    # POST /api/folders/<folder>
    def get_tree(self, sub, q):
        return 200, tree()

    def post_folders(self, sub, q):
        root, path, rel = rom_path(sub)
        if not rel:
            raise Refused(400, 'name_needed', 'Give the folder a name.')
        if os.path.exists(path):
            raise Refused(409, 'name_taken', 'There is already something with that name.')
        os.makedirs(path)
        return 200, {'ok': True, 'path': rel}

    def put_roms(self, sub, q):
        root, path, rel = rom_path(sub)
        name = os.path.basename(path)
        if not rel or os.path.isdir(path):
            raise Refused(400, 'name_needed', 'Give the file a name.')
        size = int(self.headers.get('Content-Length') or -1)
        if size < 0:
            raise Refused(411, 'bad_request', 'The upload has no length.')
        if size > FAT32_MAX:
            raise Refused(413, 'too_large', 'Files over 4 GB do not fit on the FAT32 ROM drive.')
        st = os.statvfs(root)
        if size > st.f_bavail * st.f_frsize - (1 << 20):
            raise Refused(507, 'no_space', 'Not enough free space on the ROM drive.')
        if os.path.exists(path) and q.get('replace') != ['1']:
            raise Refused(409, 'exists', 'A file with that name is already there.', exists=True)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = os.path.join(os.path.dirname(path), '.' + name + '.part')
        try:
            with open(tmp, 'wb') as f:
                left = size
                while left:
                    chunk = self.rfile.read(min(left, 1 << 20))
                    if not chunk:
                        raise OSError('the upload stopped before the end')
                    f.write(chunk)
                    left -= len(chunk)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
        except BaseException:
            try:
                os.remove(tmp)
            except OSError:
                pass
            raise
        log('uploaded', rel, size, 'bytes')
        return 200, {'ok': True, 'path': rel}

    def delete_roms(self, sub, q):
        root, path, rel = rom_path(sub)
        if not rel:
            raise Refused(400, 'name_needed', 'Give a file or folder.')
        if os.path.isdir(path):
            if any(not e.name.startswith('.') for e in os.scandir(path)):
                raise Refused(409, 'not_empty', 'The folder is not empty.')
            for e in os.scandir(path):          # leftovers such as ._ files
                os.remove(e.path)
            os.rmdir(path)
        elif os.path.isfile(path):
            os.remove(path)
        else:
            raise Refused(404, 'gone', 'Already gone.')
        log('deleted', rel)
        return 200, {'ok': True}

    def log_message(self, *a):
        pass


def main():
    load_state()
    for target in (restore_backlight, saver, render_loop, button_loop):
        threading.Thread(target=target, daemon=True).start()
    port = int(CFG['WEB_PORT'] or 0)
    if port:
        log('web page on port', port)
        server = ThreadingHTTPServer(('', port), Handler)
        server.daemon_threads = True
        server.serve_forever()
    else:
        threading.Event().wait()


if __name__ == '__main__':
    main()
