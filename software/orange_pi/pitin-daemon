def overlay_next(n):
    for _ in range(n):                              # RetroArch reads them all before its next frame
        retroarch('OVERLAY_NEXT')


def retroarch(cmd, reply=False):
    """Send one network command to RetroArch; returns its reply ('' if none or not running)."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.settimeout(0.3)
            sock.sendto(cmd.encode(), ('127.0.0.1', RA_PORT))
            return sock.recv(4096).decode(errors='replace').strip() if reply else ''
    except OSError:
        return ''


def console_language():
    """LANGUAGE in /etc/default/pitin (en or fr), otherwise the system's language."""
    lang = CFG['LANGUAGE'].lower()
    if lang in WORDS:
        return lang
    lang = os.environ.get('LANG', '')
    try:
        with open('/etc/default/locale') as f:
            for line in f:
                if line.startswith('LANG='):
                    lang = line.split('=', 1)[1].strip().strip('"')
    except OSError:
        pass
    return 'fr' if lang.lower().startswith('fr') else 'en'


class Osd:
    """Text on the screen, as RetroArch's own messages (its SHOW_MSG network command; nothing happens if RetroArch
    isn't running). A value that keeps changing (a button held) is shown once it settles, so that messages
    don't pile up."""
    SETTLE = 0.25

    def __init__(self):
        self.words = WORDS[console_language()]
        self.text, self.changed = None, 0.0
        self.cv = threading.Condition()
        threading.Thread(target=self._sender, daemon=True).start()

    def say(self, text):
        with self.cv:
            self.text = unicodedata.normalize('NFKD', text).encode('ascii', 'ignore').decode()
            self.changed = time.monotonic()
            self.cv.notify()

    def _sender(self):
        while True:
            with self.cv:
                while self.text is None:
                    self.cv.wait()
                while time.monotonic() < self.changed + self.SETTLE:
                    self.cv.wait(self.changed + self.SETTLE - time.monotonic())
                text, self.text = self.text, None
            retroarch('SHOW_MSG ' + text)


def message(item, w):
    """On-screen text for a setting and its value."""
    s = snapshot()
    if item == 'effect':
        return f"{w['effect']}: {w['effects'][s['effect'] if s['leds_on'] else 'off']}"
    if item == 'onoff':
        return w['leds_on'] if s['leds_on'] and s['effect'] != 'off' else w['leds_off']
    if item == 'screen':
        return f"{w['screen']}: {s['screen']}%"
    v = get_volume()
    return f"{w['volume']}: {v}%" if v is not None else f"{w['volume']}: --"


def change(item, step):
    """One step of a setting; True if the value changed."""
    s = snapshot()
    effect = s['effect'] if s['leds_on'] else 'off'
    if item == 'effect':                        # 'off' is SPECIAL + Y's: it keeps the effect for later
        cycle = EFFECTS[1:]
        nxt = cycle[(cycle.index(s['effect']) + step) % len(cycle)] if s['effect'] in cycle else cycle[0]
        update({'effect': nxt, 'leds_on': True})
    elif item == 'onoff':
        if effect != 'off':
            update({'leds_on': False})
        else:                                   # on again, with the same effect (an 'off' effect becomes static)
            update({'leds_on': True, 'effect': 'static' if s['effect'] == 'off' else s['effect']})
    elif item == 'screen':
        return update({'screen': s['screen'] + 5 * step})['screen'] != s['screen']
    else:
        v = get_volume()
        if v is None or not set_volume(v + 5 * step):
            return False
        return get_volume() != v
    return True


class HotkeyList:
    """SPECIAL + SELECT: pauses the game and shows the list of hotkeys, a card drawn by RetroArch's overlay. The
    overlay's cards (overlay/pitin-menu.cfg) are 0: none, 1: this list, 2: the question when a browser asks to be let
    in; OVERLAY_NEXT goes to the next one, and from the last back to 0. The gamepad is grabbed meanwhile so that
    RetroArch doesn't see the presses (Buttons does the hotkeys without SPECIAL); SELECT closes it."""

    def __init__(self):
        self.is_open = False
        self.paused = False

    def open(self, dev):
        self.is_open = True
        try:
            dev.grab()
        except OSError as e:
            log('hotkey list: cannot grab the gamepad:', e)
        self.paused = retroarch('GET_STATUS', reply=True).startswith('GET_STATUS PLAYING')
        if self.paused:
            retroarch('PAUSE_TOGGLE')
        overlay_next(1)                                 # 0 -> 1: the list

    def close(self, dev):
        self.is_open = False
        try:
            dev.ungrab()
        except OSError:
            pass
        overlay_next(2)                                 # 1 -> 2 -> 0: no card
        if self.paused and retroarch('GET_STATUS', reply=True).startswith('GET_STATUS PAUSED'):
            retroarch('PAUSE_TOGGLE')
        self.paused = False


class Buttons:
    """The hotkeys pitin-daemon handles (RetroArch has the others), and the hotkey list: while it is open, every
    button does its hotkey without SPECIAL; RetroArch's own ones are sent to it, since it doesn't see the grabbed
    gamepad."""
    HELD_KEYS = {E.BTN_TL2: ('screen', -1), E.BTN_TR2: ('screen', 1),            # hold to keep changing
                 E.BTN_DPAD_DOWN: ('volume', -1), E.BTN_DPAD_UP: ('volume', 1)}
    # Hotkeys that lose progress act only once the button has been held for HOLD seconds:
    # button: (RetroArch command, hint, whether the hotkey list closes first)
    HOLD_KEYS = {E.BTN_START: ('CLOSE_CONTENT', 'hold_quit', True), E.BTN_SOUTH: ('RESET', 'hold_reset', True),
                 E.BTN_TL: ('LOAD_STATE', 'hold_load', False)}
    RA_KEYS = {E.BTN_TR: 'SAVE_STATE', E.BTN_DPAD_LEFT: 'STATE_SLOT_MINUS', E.BTN_DPAD_RIGHT: 'STATE_SLOT_PLUS'}
    HOLD = 1.0

    def __init__(self, dev, repeater, card, osd):
        self.dev, self.repeater, self.card, self.osd = dev, repeater, card, osd
        self.held = set()
        self.presses = {}
        self.opening = self.closing = False
        self.then = None                                    # a RetroArch command to send once the list closes
        self.mx = threading.RLock()                         # key events, web requests and timers
        self.events = 0                                     # presses and releases so far
        self.asking = self.ask_waiting = self.ask_leaving = self.ask_paused = False
        self.ask_until, self.ask_round, self.ask_device = 0.0, 0, 'other'

    def stepper(self, item, step):
        first = True

        def action():
            nonlocal first
            if change(item, step) or first:             # held at the end of the range: said once
                self.osd.say(message(item, self.osd.words))
            first = False
        return action

    def long_press(self, code, press):
        if code not in self.held or self.presses.get(code) != press:
            return
        cmd, _, closes = self.HOLD_KEYS[code]
        if closes and self.card.is_open:
            self.closing = False
            self.card.close(self.dev)
        retroarch(cmd)

    def hotkey(self, code, in_list):
        """SPECIAL + code, or code alone while the hotkey list is open."""
        w = self.osd.words
        if code in self.HELD_KEYS:
            self.repeater.start(self.stepper(*self.HELD_KEYS[code]))
        elif code in self.HOLD_KEYS:
            self.osd.say(w[self.HOLD_KEYS[code][1]])
            threading.Timer(self.HOLD, self.long_press, (code, self.presses[code])).start()
        elif code == E.BTN_WEST:                            # Y: on / off, keeping the effect
            change('onoff', 0)
            self.osd.say(message('onoff', w))
        elif code == E.BTN_EAST:                            # A: next effect
            change('effect', 1)
            self.osd.say(message('effect', w))
        elif code == E.BTN_SELECT:                          # opens or closes the list once everything is released
            if in_list:
                self.closing = True
            else:
                self.opening = True
        elif in_list and code in self.RA_KEYS:              # save, save slot
            retroarch(self.RA_KEYS[code])
        elif in_list and code == E.BTN_NORTH:               # X: RetroArch's menu, after the list
            self.then, self.closing = 'MENU_TOGGLE', True

    def key(self, code, value):
        if value not in (0, 1):
            return
        with self.mx:
            self.events += 1
            if self.asking:
                self.ask_key(code, value)
            else:
                self.game_key(code, value)

    def game_key(self, code, value):
        if value == 1:
            self.held.add(code)
            self.presses[code] = self.presses.get(code, 0) + 1
            with lock:
                for ref in GROUPS.get(code, []):
                    flash[ref] = 1.0
            if self.card.is_open:
                if code != HOTKEY:
                    self.hotkey(code, True)
            elif HOTKEY in self.held and code != HOTKEY:
                self.hotkey(code, False)
        elif value == 0:
            self.held.discard(code)
            if code in self.HELD_KEYS or code == HOTKEY:
                self.repeater.stop()
            if not self.held:                               # grab and release only with no button down,
                if self.opening:                            # so RetroArch never misses a release
                    self.opening = False
                    self.card.open(self.dev)
                elif self.closing:
                    self.closing = False
                    if self.card.is_open:
                        self.card.close(self.dev)
                    if self.then:
                        retroarch(self.then)
                        self.then = None
                if self.ask_waiting and not self.card.is_open:
                    self.start_ask()

    # A phone or computer asks to be let in (letting in, below): the controls are taken as for the hotkey list and
    # the question card shown; A held for a second lets it in, B says no.
    def ask(self, device):
        with self.mx:
            self.ask_device = device
            if self.asking:
                self.ask_until = time.monotonic() + ASK_TIME
            elif self.held or self.card.is_open:
                self.ask_waiting = True                     # once every button is released, or the list closed
            else:
                self.start_ask()

    def start_ask(self):
        self.asking, self.ask_waiting, self.ask_leaving = True, False, False
        self.ask_until, self.ask_round = time.monotonic() + ASK_TIME, self.ask_round + 1
        try:
            self.dev.grab()
        except OSError as e:
            log('letting in: cannot grab the gamepad:', e)
        self.ask_paused = retroarch('GET_STATUS', reply=True).startswith('GET_STATUS PLAYING')
        if self.ask_paused:
            retroarch('PAUSE_TOGGLE')
        overlay_next(2)                                     # 0 -> 1 -> 2: the question
        threading.Thread(target=self.ask_notice, args=(self.ask_round,), daemon=True).start()

    def ask_notice(self, round_):
        """Which device asks, as on-screen text under the card (each message lasts about 3 s), until the time is up."""
        w = self.osd.words
        while True:
            with self.mx:
                if not self.asking or self.ask_leaving or self.ask_round != round_:
                    return
                if time.monotonic() > self.ask_until:
                    with auth_lock:
                        for rid in [r for r, a in asks.items() if not a['ok']]:
                            del asks[rid]
                    self.leave_ask()
                    return
                device = w['devices'][self.ask_device]
            retroarch('SHOW_MSG ' + w['ask'].format(device=device))
            time.sleep(3.5)

    def ask_key(self, code, value):
        if value == 0:
            self.held.discard(code)
            if self.ask_leaving and not self.held:
                self.leave_ask()
            return
        self.held.add(code)
        with lock:
            for ref in GROUPS.get(code, []):
                flash[ref] = 1.0
        if self.ask_leaving:
            return
        if code == E.BTN_EAST:                              # A: yes, once held for a second
            self.osd.say(self.osd.words['hold_a'])
            threading.Timer(self.HOLD, self.answer, (True, self.events)).start()
        elif code == E.BTN_SOUTH:                           # B: no
            self.answer(False, self.events)

    def answer(self, yes, events):
        with self.mx:
            if not self.asking or self.ask_leaving or self.events != events:   # A released or another press since
                return
            with auth_lock:
                for rid, a in list(asks.items()):
                    if not a['ok']:
                        if yes:
                            a['ok'] = True
                        else:
                            del asks[rid]
            self.osd.say(self.osd.words['ask_ok' if yes else 'ask_no'])
            self.ask_leaving = True                         # the controls go back once the buttons are released
            if not self.held:
                self.leave_ask()

    def leave_ask(self):
        """Gives the controls back to the game, once no button is down."""
        if self.held:
            self.ask_leaving = True
            return
        self.asking = self.ask_leaving = False
        try:
            self.dev.ungrab()
        except OSError:
            pass
        overlay_next(1)                                     # 2 -> 0: no card
        if self.ask_paused and retroarch('GET_STATUS', reply=True).startswith('GET_STATUS PAUSED'):
            retroarch('PAUSE_TOGGLE')
        self.ask_paused = False

    def lost(self):
        self.repeater.stop()
        self.held.clear()
        if self.asking:
            self.asking = self.ask_leaving = False
            overlay_next(1)
            if self.ask_paused:
                retroarch('PAUSE_TOGGLE')
        if self.card.is_open:
            self.card.is_open = False
            overlay_next(2)
            if self.card.paused:
                retroarch('PAUSE_TOGGLE')
                self.card.paused = False


def button_loop():
    repeater, osd, card = Repeater(), Osd(), HotkeyList()
    while True:
        dev = None
        while dev is None:
            for path in evdev.list_devices():
                d = evdev.InputDevice(path)
                if d.name == GAMEPAD:
                    dev = d
                    break
                d.close()
            if dev is None:
                time.sleep(2)
        log('buttons:', dev.path)
        buttons = Buttons(dev, repeater, card, osd)
        set_console_buttons(buttons)
        try:
            for ev in dev.read_loop():
                if ev.type == E.EV_KEY:
                    buttons.key(ev.code, ev.value)
        except OSError:
            set_console_buttons(None)
            buttons.lost()
            log('gamepad lost, searching again')
            time.sleep(1)


# ---------------------------------------------------------------- system
def run(*cmd):
    try:
        return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 1, str(e))


def get_volume():
    """The "Master" softvol of /etc/asound.conf; it exists once something has played sound."""
    m = re.search(r'\[(\d+)%\]', run('amixer', '-M', 'sget', 'Master').stdout)
    return int(m.group(1)) if m else None


def set_volume(v):
    return run('amixer', '-M', '-q', 'sset', 'Master', f'{int(max(0, min(100, v)))}%').returncode == 0


def local_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('192.0.2.1', 9))              # picks the outgoing interface; nothing is sent
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


def drive():
    root = os.path.realpath(CFG['ROM_MOUNT']) if CFG['ROM_MOUNT'] else ''
    if not root or not os.path.ismount(root):
        return {'mounted': False}
    st = os.statvfs(root)
    return {'mounted': True, 'free': st.f_bavail * st.f_frsize, 'total': st.f_blocks * st.f_frsize}


def info():
    d = {'hostname': socket.gethostname(), 'ip': local_ip(), 'port': web_port,
         'volume': get_volume(), 'drive': drive(),
         'retroarch': run('systemctl', 'is-active', 'pitin-retroarch.service').stdout.strip(),
         'protected': os.path.exists(SESSIONS_FILE)}
    try:
        with open('/sys/class/thermal/thermal_zone0/temp') as f:
            d['temp_c'] = round(int(f.read()) / 1000, 1)
    except (OSError, ValueError):
        pass
    try:
        with open('/proc/uptime') as f:
            d['uptime_s'] = int(float(f.read().split()[0]))
    except (OSError, ValueError):
        pass
    return d


POWER = {'retroarch': ['systemctl', 'restart', 'pitin-retroarch.service'],
         'reboot': ['systemctl', 'reboot'], 'poweroff': ['systemctl', 'poweroff']}

HOSTNAME = re.compile(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?')     # one DNS label, lower case
HOSTS, HOSTNAME_FILE = '/etc/hosts', '/etc/hostname'


def set_hostname(name):
    """The console's name on the network: as hostnamectl sets it, and in /etc/hosts in place of the old one."""
    old = socket.gethostname()
    if name == old:
        return
    r = run('hostnamectl', 'set-hostname', name)
    if r.returncode != 0:                           # no systemd-hostnamed: what it would do
        with open(HOSTNAME_FILE, 'w') as f:
            f.write(name + '\n')
        if run('hostname', name).returncode != 0:
            raise Refused(500, 'failed', 'Could not rename the console: ' + r.stdout.strip())
    try:
        with open(HOSTS) as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    found = False
    for i, line in enumerate(lines):
        addr, sep, comment = line.partition('#')
        fields = addr.split()
        if len(fields) < 2:
            continue
        names = [name + n[len(old):] if n == old or n.startswith(old + '.') else n for n in fields[1:]]
        found |= name in names
        if names != fields[1:]:
            lines[i] = fields[0] + '\t' + ' '.join(names) + (' #' + comment if sep else '')
    if not found:                                   # the console must find its own name (sudo warns otherwise)
        at = next((i + 1 for i, line in enumerate(lines) if line.split()[:1] == ['127.0.0.1']), 0)
        lines.insert(at, '127.0.1.1\t' + name)
    with open(HOSTS + '.pitin', 'w') as f:
        f.write('\n'.join(lines) + '\n')
    os.chmod(HOSTS + '.pitin', 0o644)
    os.replace(HOSTS + '.pitin', HOSTS)
    run('systemctl', 'try-restart', 'avahi-daemon.service')     # name.local, if avahi is installed
    log('console renamed:', old, '->', name)


# ---------------------------------------------------------------- letting a phone or computer in
# With this switched on, SESSIONS_FILE lists the browsers let in (hashes of their cookies); without the file, the
# page is open to the local network. A new browser asks (POST /api/ask): the console pauses the game, takes the
# controls and shows a card asking whether to let it in, with the kind of device under it (Buttons.ask); A held
# for a second says yes, B no. One browser at a time, so the answer can only go to the one named on the screen.
SESSIONS_FILE = '/var/lib/pitin/sessions.json'
COOKIE = 'pitin'
ASK_TIME = 60
auth_lock = threading.Lock()
asks = {}                     # request id -> {'until': monotonic time, 'ok': bool}
console_buttons = None        # the gamepad's Buttons, once found


def device_kind(user_agent):
    for word, kind in (('iPhone', 'iphone'), ('iPad', 'ipad'), ('Android', 'android'), ('CrOS', 'chromebook'),
                       ('Windows', 'windows'), ('Macintosh', 'mac'), ('Linux', 'linux')):
        if word in user_agent:
            return kind
    return 'other'


def set_console_buttons(b):
    global console_buttons
    console_buttons = b


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.tmp', 'w') as f:
        json.dump(data, f)
    os.chmod(path + '.tmp', 0o600)
    os.replace(path + '.tmp', path)


def token_hash(token):
    return hashlib.sha256(token.encode()).hexdigest()


def let_in(keep=True):
    """One more browser let in (keep=False: the only one); returns its cookie header. The last 50 are kept."""
    token = secrets.token_urlsafe(32)
    write_json(SESSIONS_FILE, (read_json(SESSIONS_FILE, [])[-49:] if keep else []) + [token_hash(token)])
    return {'Set-Cookie': f'{COOKIE}={token}; Max-Age=31536000; Path=/; HttpOnly; SameSite=Strict'}


def new_ask(device):
    """A browser asks to be let in: its id, or None while the console is answering another one."""
    with auth_lock:
        now = time.monotonic()
        for rid in [r for r, a in asks.items() if now > a['until']]:
            del asks[rid]
        if any(not a['ok'] for a in asks.values()):
            return None
        rid = secrets.token_urlsafe(16)
        asks[rid] = {'until': now + ASK_TIME + 5, 'ok': False}
    b = console_buttons
    if b:
        b.ask(device)
    return rid


# ---------------------------------------------------------------- ROM drive
class Refused(Exception):
    """An error for the web page: HTTP status, a short code the page translates, and an English message."""
    def __init__(self, status, key, message, **extra):
        super().__init__(message)
        self.status, self.key, self.message, self.extra = status, key, message, extra


FAT_BAD = re.compile(r'[<>:"\\|?*\x00-\x1f]')


def rom_path(rel):
    """(root, absolute path, clean relative path) inside the ROM drive, or Refused."""
    root = os.path.realpath(CFG['ROM_MOUNT']) if CFG['ROM_MOUNT'] else ''
    if not root or not os.path.ismount(root):
        raise Refused(409, 'not_mounted', 'The ROM drive is not mounted. Is the console plugged into a computer?')
    parts = [p for p in rel.split('/') if p]
    for p in parts:
        if p in ('.', '..') or FAT_BAD.search(p) or p.endswith((' ', '.')):
            raise Refused(400, 'bad_name', f'"{p}" is not a valid name on the ROM drive.')
    path = os.path.realpath(os.path.join(root, *parts))
    if path != root and not path.startswith(root + os.sep):
        raise Refused(400, 'bad_name', 'That path is outside the ROM drive.')
    return root, path, '/'.join(parts)


def tree(max_depth=4, max_entries=5000):
    """The whole ROM drive as nested folders (dot files are hidden: .Trashes, ._ files, uploads in progress)."""
    root = rom_path('')[0]
    count = 0

    def walk(path, rel, depth):
        nonlocal count
        node = {'name': os.path.basename(path) if rel else 'roms', 'path': rel, 'folders': [], 'files': []}
        try:
            entries = sorted(os.scandir(path), key=lambda e: e.name.lower())
        except OSError:
            return node
        for e in entries:
            if e.name.startswith('.') or count >= max_entries:
                continue
            count += 1
            sub = rel + '/' + e.name if rel else e.name
            if e.is_dir(follow_symlinks=False):
                node['folders'].append(walk(e.path, sub, depth + 1) if depth < max_depth else
                                       {'name': e.name, 'path': sub, 'folders': [], 'files': []})
            elif e.is_file(follow_symlinks=False):
                node['files'].append({'name': e.name, 'size': e.stat().st_size})
        return node

    return dict(drive(), tree=walk(root, '', 0), truncated=count >= max_entries)


# ---------------------------------------------------------------- web server
def page():
    try:
        with open(WEB_PAGE) as f:
            return f.read()
    except OSError:
        return '<p>Missing ' + WEB_PAGE + ': run install.sh again.</p>'


class Handler(BaseHTTPRequestHandler):
    OPEN = {'auth', 'ask', 'enter', 'logout'}      # the API calls that work without being let in

    def reply(self, code, body, ctype='application/json', headers=None):
        data = (body if isinstance(body, str) else json.dumps(body)).encode()
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def token(self):
        c = http.cookies.SimpleCookie()
        try:
            c.load(self.headers.get('Cookie', ''))
        except http.cookies.CookieError:
            return None
        return c[COOKIE].value if COOKIE in c else None

    def authorized(self):
        if not os.path.exists(SESSIONS_FILE):
            return True
        t = self.token()
        return bool(t) and token_hash(t) in read_json(SESSIONS_FILE, [])

    def body_json(self, limit=16384):
        n = int(self.headers.get('Content-Length') or 0)
        if n > limit:
            raise Refused(413, 'bad_request', 'Request too large.')
        try:
            data = json.loads(self.rfile.read(n) or b'{}')
        except ValueError:
            raise Refused(400, 'bad_request', 'Bad request.')
        if not isinstance(data, dict):
            raise Refused(400, 'bad_request', 'Bad request.')
        return data

    def route(self, method):
        url = urllib.parse.urlsplit(self.path)
        path, query = urllib.parse.unquote(url.path), urllib.parse.parse_qs(url.query)
        name = (path.strip('/').split('/') + [''])[1]
        if path == '/ping':                         # the page checks which of its addresses work
            return self.reply(200, {'ok': True})
        if path == '/' and method == 'GET':         # the page itself asks the console if needed
            return self.reply(200, page(), 'text/html; charset=utf-8')
        if not (path.startswith('/api/') and name in self.OPEN) and not self.authorized():
            return self.reply(401, {'code': 'locked', 'error': "This page needs the console's OK."})
        try:
            handler = getattr(self, method.lower() + '_' + name, None)
            if not path.startswith('/api/') or not handler:
                raise Refused(404, 'not_found', 'Not found.')
            sub = path[len('/api/'):].partition('/')[2]
            status, body, *headers = handler(sub, query)
            self.reply(status, body, headers=headers[0] if headers else None)
        except Refused as e:
            self.reply(e.status, dict(e.extra, code=e.key, error=e.message))
        except OSError as e:
            self.reply(500, {'code': 'failed', 'error': f'{e.strerror or e}.'})

    def do_GET(self):
        self.route('GET')

    def do_POST(self):
        self.route('POST')

    def do_PUT(self):
        self.route('PUT')

    def do_DELETE(self):
        self.route('DELETE')

    # GET /api/state, POST /api/state {changes}
    def get_state(self, sub, q):
        with lock:
            return 200, snapshot()

    def post_state(self, sub, q):
        return 200, update(self.body_json())

    # GET /api/info, POST /api/volume {volume}, POST /api/power {action}, POST /api/hostname {hostname}
    def get_info(self, sub, q):
        return 200, info()

    def post_volume(self, sub, q):
        v = self.body_json().get('volume')
        if not isinstance(v, (int, float)) or isinstance(v, bool):
            raise Refused(400, 'bad_request', 'Give a volume from 0 to 100.')
        if not set_volume(v):
            raise Refused(409, 'no_volume', 'No volume control yet: it appears once a game or the menu has played sound.')
        return 200, {'volume': get_volume()}

    def post_power(self, sub, q):
        action = self.body_json().get('action')
        if action not in POWER:
            raise Refused(400, 'bad_request', 'Unknown action.')
        threading.Timer(0.5, run, POWER[action]).start()
        return 200, {'ok': True}

    def post_hostname(self, sub, q):
        name = self.body_json().get('hostname')
        if not isinstance(name, str) or not HOSTNAME.fullmatch(name) or name == 'localhost':
            raise Refused(400, 'bad_hostname', 'Use letters a-z, numbers and hyphens (-), up to 63.')
        set_hostname(name)
        return 200, info()

    # Letting in. GET /api/auth, POST /api/ask (the console asks), POST /api/enter {id} (let in yet?),
    # POST /api/logout, POST /api/protect {on} (let in already: switches the console's OK on or off).
    def get_auth(self, sub, q):
        return 200, {'protected': os.path.exists(SESSIONS_FILE), 'let_in': self.authorized()}

    def post_ask(self, sub, q):
        if not os.path.exists(SESSIONS_FILE):
            return 200, {'open': True}
        device = device_kind(self.headers.get('User-Agent', ''))
        rid = new_ask(device)
        if not rid:
            raise Refused(409, 'busy', 'The console is answering another device.')
        return 200, {'id': rid, 'device': device}

    def post_enter(self, sub, q):
        rid = self.body_json().get('id')
        with auth_lock:
            if not os.path.exists(SESSIONS_FILE):
                return 200, {'ok': True}
            a = asks.get(rid) if isinstance(rid, str) else None
            if not a or (not a['ok'] and time.monotonic() > a['until']):
                raise Refused(403, 'expired', 'Not let in: the time is up or the console said no.')
            if not a['ok']:
                return 200, {'waiting': True}
            del asks[rid]
            log('page: a browser was let in from the console')
            return 200, {'ok': True}, let_in()

    def post_logout(self, sub, q):
        t = self.token()
        with auth_lock:
            if t and os.path.exists(SESSIONS_FILE):
                write_json(SESSIONS_FILE, [h for h in read_json(SESSIONS_FILE, []) if h != token_hash(t)])
        return 200, {'ok': True}, {'Set-Cookie': f'{COOKIE}=; Max-Age=0; Path=/; HttpOnly; SameSite=Strict'}

    def post_protect(self, sub, q):
        on = self.body_json().get('on')
        if not isinstance(on, bool):
            raise Refused(400, 'bad_request', 'Bad request.')
        with auth_lock:
            if not on:
                if os.path.exists(SESSIONS_FILE):
                    os.remove(SESSIONS_FILE)
                log('page: open to the local network')
                return 200, {'protected': False}
            log("page: the console's OK needed")
            return 200, {'protected': True}, let_in(keep=False)     # this browser stays in, the others need a code

    # GET /api/tree, PUT /api/roms/<file>, DELETE /api/roms/<file or empty folder>,
    # POST /api/folders/<folder>
    def get_tree(self, sub, q):
        return 200, tree()

    def post_folders(self, sub, q):
        root, path, rel = rom_path(sub)
        if not rel:
            raise Refused(400, 'name_needed', 'Give the folder a name.')
        if os.path.exists(path):
            raise Refused(409, 'name_taken', 'There is already something with that name.')
        os.makedirs(path)
        return 200, {'ok': True, 'path': rel}

    def put_roms(self, sub, q):
        root, path, rel = rom_path(sub)
        name = os.path.basename(path)
        if not rel or os.path.isdir(path):
            raise Refused(400, 'name_needed', 'Give the file a name.')
        size = int(self.headers.get('Content-Length') or -1)
        if size < 0:
            raise Refused(411, 'bad_request', 'The upload has no length.')
        if size > FAT32_MAX:
            raise Refused(413, 'too_large', 'Files over 4 GB do not fit on the FAT32 ROM drive.')
        st = os.statvfs(root)
        if size > st.f_bavail * st.f_frsize - (1 << 20):
            raise Refused(507, 'no_space', 'Not enough free space on the ROM drive.')
        if os.path.exists(path) and q.get('replace') != ['1']:
            raise Refused(409, 'exists', 'A file with that name is already there.', exists=True)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = os.path.join(os.path.dirname(path), '.' + name + '.part')
        try:
            with open(tmp, 'wb') as f:
                left = size
                while left:
                    chunk = self.rfile.read(min(left, 1 << 20))
                    if not chunk:
                        raise OSError('the upload stopped before the end')
                    f.write(chunk)
                    left -= len(chunk)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
        except BaseException:
            try:
                os.remove(tmp)
            except OSError:
                pass
            raise
        log('uploaded', rel, size, 'bytes')
        return 200, {'ok': True, 'path': rel}

    def delete_roms(self, sub, q):
        root, path, rel = rom_path(sub)
        if not rel:
            raise Refused(400, 'name_needed', 'Give a file or folder.')
        if os.path.isdir(path):
            if any(not e.name.startswith('.') for e in os.scandir(path)):
                raise Refused(409, 'not_empty', 'The folder is not empty.')
            for e in os.scandir(path):          # leftovers such as ._ files
                os.remove(e.path)
            os.rmdir(path)
        elif os.path.isfile(path):
            os.remove(path)
        else:
            raise Refused(404, 'gone', 'Already gone.')
        log('deleted', rel)
        return 200, {'ok': True}

    def log_message(self, *a):
        pass


# ---------------------------------------------------------------- the console's name on Windows (LLMNR)
LLMNR_GROUP, LLMNR_PORT = '224.0.0.252', 5355


def llmnr_answer(query, name, ip):
    """The reply to an LLMNR query (RFC 4795, the DNS message format) if it asks for name's IPv4 address."""
    if len(query) < 12:
        return None
    qid, flags, qdcount = struct.unpack('!3H', query[:6])
    if flags & 0xF800 or qdcount != 1:              # a reply, another opcode, or not one question
        return None
    i, labels = 12, []
    while i < len(query) and query[i]:
        n = query[i]
        if n & 0xC0:
            return None
        labels.append(query[i + 1:i + 1 + n])
        i += 1 + n
    i += 1
    if i + 4 > len(query):
        return None
    qtype, qclass = struct.unpack('!2H', query[i:i + 4])
    if [lab.lower() for lab in labels] != [name.lower().encode()] or qtype not in (1, 255) or qclass not in (1, 255):
        return None
    answer = b'\xc0\x0c' + struct.pack('!2HIH', 1, 1, 30, 4) + socket.inet_aton(ip)      # A, IN, 30 s
    return struct.pack('!6H', qid, 0x8000, 1, 1, 0, 0) + query[12:i + 4] + answer


def llmnr_loop():
    """Answers Windows (and systemd-resolved) when they look for the console's name without .local."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_TTL, 1)       # replies stay on the local network
    try:
        sock.bind(('', LLMNR_PORT))
    except OSError as e:
        log('LLMNR off:', e)
        return
    sock.settimeout(30)
    joined = None
    while True:
        ip = local_ip()
        if ip and ip != joined:                     # (again) once the Wi-Fi is up or its address changes
            try:
                sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP,
                                socket.inet_aton(LLMNR_GROUP) + socket.inet_aton(ip))
                joined = ip
            except OSError as e:
                joined = ip if e.errno == 98 else None      # EADDRINUSE: already a member
        try:
            query, sender = sock.recvfrom(512)
        except socket.timeout:
            continue
        except OSError:
            time.sleep(5)
            continue
        reply = ip and llmnr_answer(query, socket.gethostname(), ip)
        if reply:
            try:
                sock.sendto(reply, sender)
            except OSError:
                pass


web_port = 0


def main():
    global web_port
    load_state()
    for target in (restore_backlight, saver, render_loop, button_loop, llmnr_loop):
        threading.Thread(target=target, daemon=True).start()
    port = int(CFG['WEB_PORT'] or 0)
    if not port:
        threading.Event().wait()
    try:
        server = ThreadingHTTPServer(('', port), Handler)
    except OSError as e:                            # port 80 taken by another web server
        if port == 8080:
            raise
        log(f'port {port}: {e}; using 8080')
        port, server = 8080, ThreadingHTTPServer(('', 8080), Handler)
    web_port = port
    log('web page on port', port)
    server.daemon_threads = True
    server.serve_forever()


if __name__ == '__main__':
    main()
