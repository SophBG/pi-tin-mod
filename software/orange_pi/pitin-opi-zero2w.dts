// Pi Tin mod on an Orange Pi Zero 2W (Allwinner H618), Armbian "current" sunxi kernel.
// Device-tree overlay: display, backlight PWM, LED gate, I2S amplifier, buttons, power button,
// power-off and USB cable detect. install.sh compiles it and adds it to the user overlays.
// Needs the Armbian sunxi kernel: its AHUB audio and H616 PWM drivers are not in mainline.
//
// Header pin -> H618 pin (Orange Pi wiringOP table) -> use on the Pi Tin board:
//   5  PI7   power-off output (SHUTDOWN_PS)   16 PI14 backlight (RS/BL), PWM4
//   8  PH0   USB cable detect (USB_PWR)       19 PH7  SPI1 MOSI
//  12  PI1   I2S0 BCLK                        21 PH8  LED gate (LED_CS), SPI1 chip select 1 as GPIO
//  22  PI6   display D/C                      23 PH6  SPI1 CLK
//  24  PH5   SPI1 CS0 (display)               26 PH9  power button (SHUTDOWN_PI)
//  35  PI2   I2S0 LRCK                        40 PI3  I2S0 DOUT0 -> MAX98357A
//  Buttons: 7 LEFT PI13, 10 RIGHT PH1, 11 DOWN PH2, 13 L1 PH3, 15 L2 PI5, 18 UP PH4,
//  27 SPECIAL PI10, 28 R2 PI9, 29 SELECT PI0, 31 R1 PI15, 32 A PI11, 33 START PI12,
//  36 X PC12, 37 B PI16, 38 Y PI4. All pull to GND when pressed (no external pull-ups).
//  Pins 16 and 18 are swapped on this board (upstream: 16 UP, 18 backlight) so the
//  backlight gets a hardware PWM. The shoulder nets are named as seen from the back of
//  the PCB: net R1 (pin 13) is the left shoulder, as in the upstream GPIOnext config.
//
// GPIO specifiers are <&pio bank pin flags>: bank C=2, H=7, I=8; flags 0 = active high, 1 = active low.

/dts-v1/;
/plugin/;

/ {
	compatible = "allwinner,sun50i-h616";

	fragment@0 {
		target = <&pio>;
		__overlay__ {
			pitin_spi1_pins: pitin-spi1-pins {
				pins = "PH5", "PH6", "PH7";	/* CS0, CLK, MOSI. PH8 (MISO) is not muxed: it is the LED gate. */
				function = "spi1";
			};

			pitin_i2s0_pins: pitin-i2s0-pins {
				pins = "PI1", "PI2";		/* BCLK, LRCK. PI0 (MCLK) and PI4 (DIN) are buttons. */
				function = "i2s0";
				drive-strength = <20>;
				bias-disable;
			};

			pitin_i2s0_dout_pin: pitin-i2s0-dout-pin {
				pins = "PI3";
				function = "i2s0_dout0";
				drive-strength = <20>;
				bias-disable;
			};

			pitin_i2s0_sleep_pins: pitin-i2s0-sleep-pins {
				pins = "PI1", "PI2", "PI3";
				function = "gpio_in";
				bias-disable;
			};

			pitin_button_pins: pitin-button-pins {
				pins = "PI13", "PH1", "PH2", "PH3", "PI5", "PH4", "PI10", "PI9",
				       "PI0", "PI15", "PI11", "PI12", "PC12", "PI16", "PI4";
				function = "gpio_in";
				bias-pull-up;
			};

			pitin_pwm4_pin: pitin-pwm4-pin {
				pins = "PI14";			/* backlight MOSFET gate on the display board */
				function = "pwm4";
			};

			pitin_power_pin: pitin-power-pin {
				pins = "PH9";			/* held low by the board while running, released when the button is pressed */
				function = "gpio_in";
				bias-pull-up;
			};

			pitin_usbdet_pin: pitin-usbdet-pin {
				pins = "PH0";			/* VBUS / 2 from R133/R134 */
				function = "gpio_in";
				bias-disable;
			};
		};
	};

	/* UART0 (pins 8/10) is the debug console on this board; the Pi Tin uses those pins
	 * for USB detect and the RIGHT button. */
	fragment@1 {
		target = <&uart0>;
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@2 {
		target = <&spi1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			pinctrl-names = "default";
			pinctrl-0 = <&pitin_spi1_pins>;
			cs-gpios = <0>, <&pio 7 8 1>;	/* CS0 native (PH5), CS1 = PH8 as GPIO, active low */
			status = "okay";

			display@0 {
				compatible = "multi-inno,mi0283qt";	/* the panel of the Adafruit 1774 (ILI9341) */
				reg = <0>;
				spi-max-frequency = <50000000>;
				dc-gpios = <&pio 8 6 0>;		/* PI6, pin 22 */
				rotation = <90>;			/* use 270 if the picture is upside down */
			};

			/* LED chain: the 74AHCT1G125 passes MOSI only while CS1 (PH8) is low.
			 * /dev/spidevN.1 is used by pitin_leds.py. */
			spidev@1 {
				compatible = "rohm,dh2228fv";
				reg = <1>;
				spi-max-frequency = <8000000>;
			};
		};
	};

	/* USB-C OTG port (USB0): device mode, for the USB-drive mode. */
	fragment@3 {
		target = <&usbotg>;
		__overlay__ {
			dr_mode = "peripheral";
			status = "okay";
		};
	};

	fragment@4 {
		target-path = "/";
		__overlay__ {
			pitin-gamepad {
				compatible = "gpio-keys";
				label = "Pi Tin Gamepad";
				pinctrl-names = "default";
				pinctrl-0 = <&pitin_button_pins>;

				/* Gamepad codes, so the console (tty) never sees them as typing.
				 * RetroArch numbers them in this order: B 0, A 1, X 2, Y 3, L1 4, R1 5,
				 * L2 6, R2 7, SELECT 8, START 9, SPECIAL 10, UP 11, DOWN 12, LEFT 13, RIGHT 14. */
				b      { label = "B";       gpios = <&pio 8 16 1>; linux,code = <304>; debounce-interval = <10>; }; /* BTN_SOUTH, pin 37 */
				a      { label = "A";       gpios = <&pio 8 11 1>; linux,code = <305>; debounce-interval = <10>; }; /* BTN_EAST, pin 32 */
				x      { label = "X";       gpios = <&pio 2 12 1>; linux,code = <307>; debounce-interval = <10>; }; /* BTN_NORTH, pin 36 */
				y      { label = "Y";       gpios = <&pio 8 4 1>;  linux,code = <308>; debounce-interval = <10>; }; /* BTN_WEST, pin 38 */
				l1     { label = "L1";      gpios = <&pio 7 3 1>;  linux,code = <310>; debounce-interval = <10>; }; /* BTN_TL, pin 13 */
				r1     { label = "R1";      gpios = <&pio 8 15 1>; linux,code = <311>; debounce-interval = <10>; }; /* BTN_TR, pin 31 */
				l2     { label = "L2";      gpios = <&pio 8 5 1>;  linux,code = <312>; debounce-interval = <10>; }; /* BTN_TL2, pin 15 */
				r2     { label = "R2";      gpios = <&pio 8 9 1>;  linux,code = <313>; debounce-interval = <10>; }; /* BTN_TR2, pin 28 */
				select { label = "SELECT";  gpios = <&pio 8 0 1>;  linux,code = <314>; debounce-interval = <10>; }; /* BTN_SELECT, pin 29 */
				start  { label = "START";   gpios = <&pio 8 12 1>; linux,code = <315>; debounce-interval = <10>; }; /* BTN_START, pin 33 */
				special { label = "SPECIAL"; gpios = <&pio 8 10 1>; linux,code = <316>; debounce-interval = <10>; }; /* BTN_MODE, pin 27 */
				up     { label = "UP";      gpios = <&pio 7 4 1>;  linux,code = <544>; debounce-interval = <10>; }; /* BTN_DPAD_UP, pin 18 */
				down   { label = "DOWN";    gpios = <&pio 7 2 1>;  linux,code = <545>; debounce-interval = <10>; }; /* BTN_DPAD_DOWN, pin 11 */
				left   { label = "LEFT";    gpios = <&pio 8 13 1>; linux,code = <546>; debounce-interval = <10>; }; /* BTN_DPAD_LEFT, pin 7 */
				right  { label = "RIGHT";   gpios = <&pio 7 1 1>;  linux,code = <547>; debounce-interval = <10>; }; /* BTN_DPAD_RIGHT, pin 10 */
			};

			pitin-system {
				compatible = "gpio-keys";
				label = "Pi Tin System";
				pinctrl-names = "default";
				pinctrl-0 = <&pitin_power_pin>, <&pitin_usbdet_pin>;

				power {
					label = "POWER";
					gpios = <&pio 7 9 0>;		/* PH9, pin 26, active high */
					linux,code = <116>;		/* KEY_POWER: systemd-logind powers off */
					debounce-interval = <100>;
				};

				usb-detect {
					label = "USB";
					gpios = <&pio 7 0 0>;		/* PH0, pin 8, high while a USB cable is plugged in */
					linux,input-type = <5>;		/* EV_SW */
					linux,code = <6>;		/* SW_USB_INSERT, read by pitin-usbd */
					debounce-interval = <100>;
				};
			};

			/* Screen backlight: /sys/class/backlight/pitin-backlight, set by pitin-daemon.
			 * 20 kHz; without a brightness-levels table the kernel uses a perceptual curve. */
			pitin-backlight {
				compatible = "pwm-backlight";
				pwms = <&pwm 4 50000 0>;
			};

			/* Pin 5 low cuts the Pi Tin's power latch (same as gpio-poweroff on the Pi).
			 * Priority above the firmware (PSCI) handler, so it runs first. */
			pitin-poweroff {
				compatible = "gpio-poweroff";
				gpios = <&pio 8 7 1>;			/* PI7, active low */
				priority = <255>;
			};
		};
	};

	/* I2S0 -> MAX98357A, through the AHUB audio driver of the Armbian kernel. Based on the
	 * overlays reported working on this board on the DietPi forum. */
	fragment@5 {
		target-path = "/soc";
		__overlay__ {
			pitin_ahub_plat: pitin-ahub-plat {
				#sound-dai-cells = <0>;
				compatible = "allwinner,sunxi-snd-plat-ahub";
				apb_num = <0>;
				dmas = <&dma 3>, <&dma 3>;
				dma-names = "tx", "rx";
				playback_cma = <128>;
				capture_cma = <128>;
				tx_fifo_size = <128>;
				rx_fifo_size = <128>;
				tdm_num = <0>;
				tx_pin = <0>;
				rx_pin = <0>;
				pinctrl-names = "default", "sleep";
				pinctrl_used;
				pinctrl-0 = <&pitin_i2s0_pins>, <&pitin_i2s0_dout_pin>;
				pinctrl-1 = <&pitin_i2s0_sleep_pins>;
				status = "okay";
			};

			pitin-ahub-mach {
				compatible = "allwinner,sunxi-snd-mach";
				soundcard-mach,name = "pitin";
				soundcard-mach,format = "i2s";
				soundcard-mach,frame-master = <&pitin_ahub_cpu>;
				soundcard-mach,bitclock-master = <&pitin_ahub_cpu>;
				soundcard-mach,slot-num = <2>;
				soundcard-mach,slot-width = <32>;
				status = "okay";

				pitin_ahub_cpu: soundcard-mach,cpu {
					sound-dai = <&pitin_ahub_plat>;
					soundcard-mach,pll-fs = <4>;
					soundcard-mach,mclk-fs = <0>;
				};

				soundcard-mach,codec {
				};
			};

			hdmi@6000000 {
				status = "disabled";		/* not used in the Pi Tin; as in the working audio overlays */
			};
		};
	};

	/* PWM4 on PI14 (header pin 16), through Armbian's H616 PWM driver (pwm-sunxi-enhance). */
	fragment@6 {
		target = <&pwm>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&pwm4>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&pitin_pwm4_pin>;
			status = "okay";
		};
	};
};
